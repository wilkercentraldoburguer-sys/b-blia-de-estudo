{
  "name": "UserPreferences",
  "type": "object",
  "properties": {
    "versao_padrao": {
      "type": "string",
      "default": "ARA",
      "description": "Vers\u00e3o padr\u00e3o do usu\u00e1rio"
    },
    "versoes_ativas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "ARA",
        "ARC",
        "NVI"
      ],
      "description": "Vers\u00f5es ativadas pelo usu\u00e1rio"
    },
    "comentaristas_ativos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "Ryrie"
      ],
      "description": "Comentaristas ativos"
    },
    "tema": {
      "type": "string",
      "enum": [
        "claro",
        "escuro",
        "sepia",
        "azul"
      ],
      "default": "claro",
      "description": "Tema da interface"
    },
    "tamanho_fonte": {
      "type": "string",
      "enum": [
        "pequena",
        "media",
        "grande",
        "extra_grande"
      ],
      "default": "media",
      "description": "Tamanho da fonte"
    },
    "interesses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Temas de interesse do usu\u00e1rio"
    },
    "objetivo_leitura": {
      "type": "string",
      "enum": [
        "conhecimento_geral",
        "devocional_diario",
        "estudo_profundo",
        "leitura_completa"
      ],
      "default": "conhecimento_geral",
      "description": "Objetivo de leitura do usu\u00e1rio"
    },
    "tempo_disponivel": {
      "type": "string",
      "enum": [
        "5_min",
        "15_min",
        "30_min",
        "1_hora"
      ],
      "default": "15_min",
      "description": "Tempo dispon\u00edvel para leitura di\u00e1ria"
    },
    "ultima_recomendacao": {
      "type": "string",
      "format": "date",
      "description": "Data da \u00faltima recomenda\u00e7\u00e3o de vers\u00edculo"
    },
    "versiculos_lidos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Refer\u00eancias de vers\u00edculos j\u00e1 lidos"
    }
  },
  "required": []
}