{
  "name": "Highlight",
  "type": "object",
  "properties": {
    "book": {
      "type": "string",
      "description": "Nome do livro b\u00edblico"
    },
    "chapter": {
      "type": "integer",
      "description": "N\u00famero do cap\u00edtulo"
    },
    "verse": {
      "type": "integer",
      "description": "N\u00famero do vers\u00edculo"
    },
    "color": {
      "type": "string",
      "enum": [
        "yellow",
        "pink",
        "red",
        "purple",
        "blue",
        "green"
      ],
      "description": "Cor do destaque"
    },
    "verse_text": {
      "type": "string",
      "description": "Texto do vers\u00edculo"
    }
  },
  "required": [
    "book",
    "chapter",
    "verse",
    "color",
    "verse_text"
  ]
}