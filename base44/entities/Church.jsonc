{
  "name": "Church",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da igreja"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade onde a igreja est\u00e1 localizada"
    },
    "denominacao": {
      "type": "string",
      "description": "Denomina\u00e7\u00e3o (opcional)"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativa",
        "oculta"
      ],
      "default": "ativa",
      "description": "Status da igreja"
    },
    "pastor_responsavel": {
      "type": "string",
      "description": "Nome do pastor respons\u00e1vel"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da igreja"
    }
  },
  "required": [
    "nome",
    "cidade"
  ]
}